# BILLING_GUARD_DRY_RUN=true logs what the function would do instead of
# actually calling the Cloud Billing API. See docs/billing-kill-switch.md.
BILLING_GUARD_DRY_RUN=
# Exact budgetId from the Cloud Billing Pub/Sub notification.
# Without it the guard fails closed and will not disable billing.
BILLING_GUARD_BUDGET_ID=
