rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // HELPER FUNCTIONS
    // ============================

    // Returns true for a legacy owner id or when this signed-in device is
    // connected to the permanent account id through userLinks.
    function playerOwnsOrLinked(ownerId) {
      return request.auth != null && (
        request.auth.uid == ownerId ||
        (
          exists(/databases/$(database)/documents/userLinks/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/userLinks/$(request.auth.uid)).data.primaryUid == ownerId
        )
      );
    }

    // Returns true if the authenticated user is the DM with the given dmId,
    // or if their device is linked to that DM via userLinks.
    function dmOwnsOrLinked(dmId) {
      return request.auth != null && (
        request.auth.uid == dmId ||
        (
          exists(/databases/$(database)/documents/userLinks/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/userLinks/$(request.auth.uid)).data.primaryUid == dmId
        )
      );
    }

    function campaignMemberOrLinked(campaignId) {
      let campaign = get(/databases/$(database)/documents/campaigns/$(campaignId));
      return request.auth != null && (
        request.auth.uid in campaign.data.get('memberIds', []) ||
        (
          exists(/databases/$(database)/documents/userLinks/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/userLinks/$(request.auth.uid)).data.primaryUid
            in campaign.data.get('memberIds', [])
        )
      );
    }

    function boundedQuery(maximum) {
      return request.query.limit != null &&
             request.query.limit > 0 &&
             request.query.limit <= maximum;
    }

    function validOptionalString(data, key, maximum) {
      return data.get(key, '') is string && data.get(key, '').size() <= maximum;
    }

    function validOptionalList(data, key, maximum) {
      return data.get(key, []) is list && data.get(key, []).size() <= maximum;
    }

    function validOptionalNumber(data, key, minimum, maximum) {
      return !(key in data) ||
             (data[key] is number && data[key] >= minimum && data[key] <= maximum);
    }

    function validDocumentId(value) {
      return value is string && value.size() > 0 && value.size() <= 1500;
    }

    function validRecoveryCode(value) {
      return value is string && value.matches('^DH-[A-Z0-9]{4}-[A-Z0-9]{4}$');
    }

    function validCharacterRecoveryCode(value) {
      return value == '' || validRecoveryCode(value);
    }

    function validCreator(data) {
      return data is map &&
             data.keys().hasOnly(['userId', 'characterId', 'characterName']) &&
             validDocumentId(data.userId) &&
             validOptionalString(data, 'characterId', 1500) &&
             validOptionalString(data, 'characterName', 100);
    }

    function validCharacterData(data, campaignId) {
      return data.keys().hasOnly([
               'campaignId',
               'userId',
               'recoveryCode',
               'isEditableByPlayer',
               'createdAt',
               'updatedAt',
               'header',
               'characteristics',
               'skills',
               'wounds',
               'fate',
               'insanity',
               'corruption',
               'movement',
               'rangedWeapons',
               'meleeWeapons',
               'armour',
               'talentsAndTraits',
               'gear',
               'consumables',
               'drugs',
               'grenades',
               'shields',
               'cybernetics',
               'archeotech',
               'companions',
               'weaponTraining',
               'experience',
               'psychic',
               'notes',
               'portraitUrl',
               'backgroundComplete'
             ]) &&
             data.campaignId == campaignId &&
             (data.userId == null || (data.userId is string && data.userId.size() > 0)) &&
             validCharacterRecoveryCode(data.recoveryCode) &&
             data.isEditableByPlayer is bool &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             data.header is map &&
             data.header.characterName is string &&
             data.header.characterName.size() > 0 &&
             data.header.characterName.size() <= 100 &&
             data.characteristics is map && data.characteristics.size() == 9 &&
             data.wounds is map && data.wounds.size() <= 10 &&
             data.fate is map && data.fate.size() <= 10 &&
             data.movement is map && data.movement.size() <= 10 &&
             data.experience is map && data.experience.size() <= 10 &&
             data.experience.total is int && data.experience.total >= 0 &&
             data.experience.total <= 10000000 &&
             data.experience.spent is int && data.experience.spent >= 0 &&
             data.experience.spent <= 10000000 &&
             data.insanity is map && data.insanity.size() <= 100 &&
             data.corruption is map && data.corruption.size() <= 100 &&
             data.talentsAndTraits is map && data.talentsAndTraits.size() <= 100 &&
             data.weaponTraining is map && data.weaponTraining.size() <= 100 &&
             data.psychic is map && data.psychic.size() <= 100 &&
             data.skills is list && data.skills.size() <= 200 &&
             data.rangedWeapons is list && data.rangedWeapons.size() <= 200 &&
             data.meleeWeapons is list && data.meleeWeapons.size() <= 200 &&
             data.armour is list && data.armour.size() <= 200 &&
             data.gear is list && data.gear.size() <= 200 &&
             validOptionalList(data, 'consumables', 200) &&
             validOptionalList(data, 'drugs', 200) &&
             validOptionalList(data, 'grenades', 200) &&
             validOptionalList(data, 'shields', 200) &&
             validOptionalList(data, 'cybernetics', 200) &&
             validOptionalList(data, 'archeotech', 200) &&
             validOptionalList(data, 'companions', 200) &&
             (!('notes' in data) ||
               (data.notes is string && data.notes.size() <= 4000) ||
               (data.notes is list && data.notes.size() <= 200)) &&
             (!('portraitUrl' in data) ||
               (data.portraitUrl is string && data.portraitUrl.size() <= 350000)) &&
             (!('backgroundComplete' in data) || data.backgroundComplete is bool);
    }

    function validUserData(data) {
      return data.keys().hasOnly([
               'role',
               'activeCampaignId',
               'createdAt',
               'onboarded',
               'recoveryBackedUp'
             ]) &&
             (!('role' in data) || data.role in ['player', 'dm']) &&
             (!('activeCampaignId' in data) || data.activeCampaignId == null ||
               validDocumentId(data.activeCampaignId)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('onboarded' in data) || data.onboarded is bool) &&
             (!('recoveryBackedUp' in data) || data.recoveryBackedUp is bool);
    }

    function validCampaignData(data) {
      return data.keys().hasOnly([
               'name',
               'dmId',
               'memberIds',
               'createdAt',
               'archivedAt',
               'gmName',
               'inquisitorName'
             ]) &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             validDocumentId(data.dmId) &&
             data.get('memberIds', []) is list &&
             data.get('memberIds', []).size() <= 100 &&
             data.get('memberIds', []).toSet().size() == data.get('memberIds', []).size() &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('archivedAt' in data) || data.archivedAt == null || data.archivedAt is timestamp) &&
             (!('gmName' in data) || (data.gmName is string && data.gmName.size() <= 100)) &&
             (!('inquisitorName' in data) || (data.inquisitorName is string && data.inquisitorName.size() <= 100));
    }

    // ============================
    // USERS
    // ============================
    match /users/{userId} {
      allow read:
        if request.auth != null &&
           request.auth.uid == userId;
      allow create, update:
        if request.auth != null &&
           request.auth.uid == userId &&
           validUserData(request.resource.data);
    }

    // ============================
    // USER PROFILES (public first-name directory)
    // ============================
    // Readable by any authenticated user so DMs and party members can display
    // the owner's first name on character sheets (consistent with campaigns and
    // characters, which are already authed-readable). Writes go through the
    // updateDisplayName Function so the profile and campaign name copies change
    // atomically.
    match /userProfiles/{userId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ============================
    // CAMPAIGNS
    // ============================
    match /campaigns/{campaignId} {

      // DM (or a linked device) or a current member can read campaign metadata.
      // Full campaign metadata stays locked to DM + members.
      allow get: if dmOwnsOrLinked(resource.data.dmId) ||
                     (
                       request.auth != null &&
                       (
                         request.auth.uid in resource.data.get('memberIds', []) ||
                         (
                           exists(/databases/$(database)/documents/userLinks/$(request.auth.uid)) &&
                           get(/databases/$(database)/documents/userLinks/$(request.auth.uid)).data.primaryUid
                             in resource.data.get('memberIds', [])
                         )
                       )
                     );
      allow list: if (dmOwnsOrLinked(resource.data.dmId) ||
                       (
                         request.auth != null &&
                         (
                           request.auth.uid in resource.data.get('memberIds', []) ||
                           (
                             exists(/databases/$(database)/documents/userLinks/$(request.auth.uid)) &&
                             get(/databases/$(database)/documents/userLinks/$(request.auth.uid)).data.primaryUid
                               in resource.data.get('memberIds', [])
                           )
                         )
                       )) &&
                     boundedQuery(100);

      // Creation is server-only so account resolution, rate limiting, and the
      // overall campaign ceiling cannot be bypassed by a modified client.
      allow create: if false;

      // DM (or a linked device) can update any campaign field (except transferring ownership).
      allow update:
        if dmOwnsOrLinked(resource.data.dmId) &&
           validCampaignData(request.resource.data) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name',
             'memberIds',
             'archivedAt',
             'gmName',
             'inquisitorName'
           ]) &&
           (
             !("dmId" in request.resource.data) ||
             request.resource.data.dmId == resource.data.dmId
           );

      // Deletion is server-only because Firestore document deletion does not
      // cascade into characters, messages, or Recovery Index records.
      allow delete: if false;

      // ============================
      // CAMPAIGN CUSTOM ITEM LIBRARY
      // ============================
      match /customItems/{customItemId} {

        function dmOwnsCampaign() {
          let camp = get(/databases/$(database)/documents/campaigns/$(campaignId));
          return camp != null && dmOwnsOrLinked(camp.data.dmId);
        }

        function userOwnsCreator(data) {
          return ("creator" in data) &&
                 data.creator.userId is string &&
                 playerOwnsOrLinked(data.creator.userId);
        }

        function canReadCustomItem(data) {
          return request.auth != null &&
                 (
                   data.status == "published" ||
                   dmOwnsCampaign() ||
                   userOwnsCreator(data)
                 );
        }

        allow get: if canReadCustomItem(resource.data);
        allow list: if canReadCustomItem(resource.data) && boundedQuery(200);

        // Custom-item mutations use the protected callable. Denying client
        // writes here removes their cost from Firestore's rule expression budget.
        allow create, update, delete: if false;

        match /versions/{versionId} {

          function dmOwnsCampaign() {
            let camp = get(/databases/$(database)/documents/campaigns/$(campaignId));
            return camp != null && dmOwnsOrLinked(camp.data.dmId);
          }

          function parentItem() {
            return get(/databases/$(database)/documents/campaigns/$(campaignId)/customItems/$(customItemId));
          }

          function userOwnsParentCreator(parent) {
            return parent.data.creator.userId is string &&
                   playerOwnsOrLinked(parent.data.creator.userId);
          }

          function canReadParentVersion() {
            let parent = parentItem();
            return request.auth != null &&
                   parent != null &&
                   (
                     parent.data.status == "published" ||
                     dmOwnsCampaign() ||
                     userOwnsParentCreator(parent)
                   );
          }

          allow get: if canReadParentVersion();
          allow list: if canReadParentVersion() && boundedQuery(100);

          allow create, update, delete: if false;
        }
      }

      // ============================
      // CHARACTERS
      // ============================
      match /characters/{characterId} {

        function dmOwnsCampaign() {
          let camp = get(/databases/$(database)/documents/campaigns/$(campaignId));
          return camp != null && dmOwnsOrLinked(camp.data.dmId);
        }

        // Only the owning player (or a linked device) or the campaign's DM can
        // read a character. A claim preview doesn't need a direct read here —
        // lookupRecoveryCode returns its own minimal preview server-side.
        allow get: if playerOwnsOrLinked(resource.data.userId) || dmOwnsCampaign();
        allow list: if (dmOwnsCampaign() || playerOwnsOrLinked(resource.data.userId)) && boundedQuery(100);

        allow create:
          if dmOwnsCampaign() &&
             validCharacterData(request.resource.data, campaignId) &&
             request.resource.data.userId == null &&
             request.resource.data.isEditableByPlayer == false &&
             request.resource.data.recoveryCode == '';

        // Fields migrated to patchCharacterField (see functions/src/operations/
        // patchCharacterField.ts) are frozen against direct client writes here.
        // A single MapDiff check keeps this cheap regardless of how many fields
        // are listed — checking each field individually would cost its own
        // get()+get()+== triplet, risking Firestore's 1,000-expression
        // evaluation ceiling on a large update.
        function noPatchedFieldsChanged() {
          let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
          let patchedFields = [
            'notes', 'header', 'portraitUrl', 'characteristics', 'talentsAndTraits',
            'weaponTraining', 'psychic', 'insanity', 'cybernetics', 'rangedWeapons',
            'meleeWeapons', 'archeotech', 'gear', 'consumables', 'drugs', 'grenades',
            'shields', 'armour', 'companions', 'skills', 'wounds', 'fate', 'corruption',
            'movement', 'experience'
          ];
          return !changedKeys.hasAny(patchedFields);
        }

        // Ownership changes (claim, release, force-release, force-assign) all
        // go through their own dedicated Cloud Functions, none of which touch
        // this rule (Admin SDK bypasses rules entirely). Direct writes never
        // legitimately change userId, for either the DM or the owning player,
        // so it's pinned unconditionally here.
        allow update:
          if validCharacterData(request.resource.data, campaignId) &&
             request.resource.data.recoveryCode == resource.data.recoveryCode &&
             request.resource.data.userId == resource.data.userId &&
             noPatchedFieldsChanged() &&
             (
               dmOwnsCampaign() ||
               (
                 playerOwnsOrLinked(resource.data.userId) &&
                 resource.data.isEditableByPlayer == true &&
                 request.resource.data.isEditableByPlayer == resource.data.isEditableByPlayer
               )
             );

        allow delete: if dmOwnsCampaign();

        // ============================
        // CLAIM LOGS
        // ============================
        match /claimLog/{logId} {

          function dmOwnsCampaign() {
            let camp = get(/databases/$(database)/documents/campaigns/$(campaignId));
            return camp != null && dmOwnsOrLinked(camp.data.dmId);
          }

          allow get: if dmOwnsCampaign();
          allow list: if dmOwnsCampaign() && boundedQuery(440);

          allow update: if false;

          // Deletable only as a consequence of the character itself being
          // deleted in the same atomic write — never on its own.
          allow delete:
            if dmOwnsCampaign() &&
               !existsAfter(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId));
        }

        match /xpHistory/{entryId} {

          function canReadXpHistory() {
            let character = get(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId));
            return character != null &&
              (dmOwnsCampaign() || playerOwnsOrLinked(character.data.userId));
          }

          allow get: if canReadXpHistory();
          allow list: if canReadXpHistory() && boundedQuery(100);
          allow create, update, delete: if false;
        }
      }
    }

    // ============================
    // recoveryIndex — top-level
    // ============================
    match /recoveryIndex/{indexId} {
      // HMAC-derived Recovery Index entries are managed exclusively by trusted
      // Cloud Functions through the Admin SDK. Raw clients never read or write
      // this collection.
      allow read, write: if false;
    }

    // ============================
    // IDENTITY SECRET — proof store (uid → code), rule-side only
    // ============================
    // The plain-text copy is never returned by a client Firestore read.
    // Reveal and rotation are server-only.
    match /identitySecret/{uid} {
      allow read: if false;
      // Rotation and revocation are server-only so the recovery index and
      // plaintext secret can never get out of sync.
      allow create, update, delete: if false;
    }

    // Permanent account records are server-owned lifecycle metadata.
    match /accounts/{accountId} {
      allow read, write: if false;
    }

    // ============================
    // USER LINKS — multi-device access
    // ============================
    // Every device has its own UID as the document key. primaryUid is retained
    // as the stored field name but now points to a permanent account id.
    match /userLinks/{uid} {
      // A device can read its own link doc.
      allow get: if request.auth != null && uid == request.auth.uid;
      // A linked device may list only its own account's bounded device set.
      // The query must constrain primaryUid to that account for this rule to pass.
      allow list: if request.auth != null &&
                     (resource.data.primaryUid == request.auth.uid ||
                      (exists(/databases/$(database)/documents/userLinks/$(request.auth.uid)) &&
                       resource.data.primaryUid ==
                         get(/databases/$(database)/documents/userLinks/$(request.auth.uid)).data.primaryUid)) &&
                     boundedQuery(200);
      // Connecting and disconnecting are server-only so a device cannot skip
      // lifecycle and last-device safeguards.
      allow create, update, delete: if false;
    }

    // ============================
    // CHARACTER SUMMARIES
    // Restricted, campaign-member-readable view of a character. Kept in
    // sync with the real character document by characterService.ts; never
    // contains the Recovery Code or any other sheet data.
    // ============================
    match /campaigns/{campaignId}/characterSummaries/{characterId} {

      function dmOwnsCampaign() {
        let camp = get(/databases/$(database)/documents/campaigns/$(campaignId));
        return camp != null && dmOwnsOrLinked(camp.data.dmId);
      }

      function campaignMember(uid) {
        let camp = get(/databases/$(database)/documents/campaigns/$(campaignId));
        return camp != null && uid in camp.data.get('memberIds', []);
      }

      function ownsCharacter() {
        let char = get(
          /databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId)
        );
        return char != null && playerOwnsOrLinked(char.data.userId);
      }

      function validCharacterSummary(data) {
        return data.keys().hasOnly([
                 'campaignId', 'characterName', 'playerName', 'career', 'rank', 'portraitUrl',
                 'userId'
               ]) &&
               data.keys().hasAll(['campaignId', 'characterName', 'userId']) &&
               data.campaignId == campaignId &&
               data.characterName is string &&
               data.characterName.size() > 0 &&
               data.characterName.size() <= 100 &&
               validOptionalString(data, 'playerName', 50) &&
               validOptionalString(data, 'career', 100) &&
               validOptionalString(data, 'rank', 100) &&
               (!('portraitUrl' in data) ||
                 (data.portraitUrl is string && data.portraitUrl.size() <= 350000)) &&
               (data.userId == null || data.userId is string);
      }

      allow get: if dmOwnsCampaign() || (request.auth != null && campaignMember(request.auth.uid));
      allow list:
        if (dmOwnsCampaign() || (request.auth != null && campaignMember(request.auth.uid))) &&
           boundedQuery(100);

      allow create, update:
        if validCharacterSummary(request.resource.data) &&
           (dmOwnsCampaign() || ownsCharacter());

      allow delete:
        if dmOwnsCampaign() &&
           !existsAfter(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId));
    }

    // ============================
    // SESSIONS
    // ============================
    match /campaigns/{campaignId}/sessions/{sessionId} {

      function dmOwnsCampaign() {
        return dmOwnsOrLinked(
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmId
        );
      }

      function validSessionData(data) {
        return data.keys().hasOnly([
                 'date',
                 'summary',
                 'dmNotes',
                 'xpAwarded',
                 'attendees',
                 'createdAt',
                 'xpApplied'
               ]) &&
               data.date is timestamp &&
               data.summary is string &&
               data.summary.size() <= 4000 &&
               data.dmNotes is string &&
               data.dmNotes.size() <= 4000 &&
               data.xpAwarded is int &&
               data.xpAwarded >= 0 &&
               data.xpAwarded <= 100000 &&
               data.attendees is list &&
               data.attendees.size() <= 100 &&
               data.attendees.toSet().size() == data.attendees.size() &&
               data.createdAt is timestamp &&
               (!('xpApplied' in data) || data.xpApplied is bool);
      }

      function validSessionXpBoundary() {
        let hadAppliedField = 'xpApplied' in resource.data;
        let hasAppliedField = 'xpApplied' in request.resource.data;
        let wasApplied = hadAppliedField && resource.data.xpApplied == true;
        let remainsSame = hadAppliedField == hasAppliedField &&
          (!hadAppliedField || request.resource.data.xpApplied == resource.data.xpApplied);
        return remainsSame &&
          (!wasApplied ||
            (request.resource.data.xpAwarded == resource.data.xpAwarded &&
             request.resource.data.attendees == resource.data.attendees));
      }

      // Full session records contain private DM notes and are DM-only.
      allow get: if dmOwnsCampaign();
      allow list: if dmOwnsCampaign() && boundedQuery(200);
      allow create: if dmOwnsCampaign() &&
        validSessionData(request.resource.data) &&
        (!('xpApplied' in request.resource.data) || request.resource.data.xpApplied == false);
      allow update: if dmOwnsCampaign() &&
        validSessionData(request.resource.data) &&
        validSessionXpBoundary();
      allow delete: if false;
    }

    // Member-facing session history deliberately excludes private DM notes.
    match /campaigns/{campaignId}/sessionSummaries/{sessionId} {

      function dmOwnsCampaign() {
        return dmOwnsOrLinked(
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmId
        );
      }

      function validSessionSummaryData(data) {
        return data.keys().hasOnly([
                 'date',
                 'summary',
                 'xpAwarded',
                 'attendees',
                 'createdAt',
                 'xpApplied'
               ]) &&
               data.date is timestamp &&
               data.summary is string &&
               data.summary.size() <= 4000 &&
               data.xpAwarded is int &&
               data.xpAwarded >= 0 &&
               data.xpAwarded <= 100000 &&
               data.attendees is list &&
               data.attendees.size() <= 100 &&
               data.attendees.toSet().size() == data.attendees.size() &&
               data.createdAt is timestamp &&
               (!('xpApplied' in data) || data.xpApplied is bool);
      }

      function validSessionXpBoundary() {
        let hadAppliedField = 'xpApplied' in resource.data;
        let hasAppliedField = 'xpApplied' in request.resource.data;
        let wasApplied = hadAppliedField && resource.data.xpApplied == true;
        let remainsSame = hadAppliedField == hasAppliedField &&
          (!hadAppliedField || request.resource.data.xpApplied == resource.data.xpApplied);
        return remainsSame &&
          (!wasApplied ||
            (request.resource.data.xpAwarded == resource.data.xpAwarded &&
             request.resource.data.attendees == resource.data.attendees));
      }

      allow get:
        if dmOwnsCampaign() || campaignMemberOrLinked(campaignId);
      allow list:
        if (dmOwnsCampaign() || campaignMemberOrLinked(campaignId)) && boundedQuery(200);
      allow create:
        if dmOwnsCampaign() &&
           validSessionSummaryData(request.resource.data) &&
           (!('xpApplied' in request.resource.data) || request.resource.data.xpApplied == false);
      allow update:
        if dmOwnsCampaign() &&
           validSessionSummaryData(request.resource.data) &&
           validSessionXpBoundary();
      allow delete: if false;
    }

    // ============================
    // MESSAGES
    // Threads are keyed by characterId — one thread per character, not per player.
    // ============================
    match /campaigns/{campaignId}/threads/{characterId} {

      function dmOwnsMessagingCampaign() {
        return dmOwnsOrLinked(
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmId
        );
      }

      // The player who owns this character — or a linked device — can access the thread.
      function playerOwnsCharacter() {
        return playerOwnsOrLinked(
          get(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId))
            .data.userId
        );
      }


      function validThreadData(data) {
        return data.keys().hasOnly([
                 'characterId',
                 'lastMessage',
                 'lastTimestamp',
                 'unreadForDM'
               ]) &&
               data.characterId == characterId &&
               (data.get('lastMessage', null) == null ||
                  (data.lastMessage is string && data.lastMessage.size() > 0 &&
                   data.lastMessage.size() <= 500)) &&
               (data.get('lastTimestamp', null) == null || data.lastTimestamp is timestamp) &&
               data.get('unreadForDM', 0) is int &&
               data.get('unreadForDM', 0) >= 0 &&
               data.get('unreadForDM', 0) <= 10000;
      }

      // DM reads all thread summaries; player reads only their own character's thread
      allow get: if dmOwnsMessagingCampaign() || playerOwnsCharacter();
      allow list:
        if (dmOwnsMessagingCampaign() || playerOwnsCharacter()) && boundedQuery(100);

      allow create:
        if validThreadData(request.resource.data) &&
           (
              (dmOwnsMessagingCampaign() &&
                request.resource.data.get('unreadForDM', 0) == 0 &&
                request.resource.data.get('lastMessage', null) is string &&
                request.resource.data.lastTimestamp is timestamp) ||
              (playerOwnsCharacter() &&
                request.resource.data.get('unreadForDM', 0) == 1 &&
                request.resource.data.get('lastMessage', null) is string &&
                request.resource.data.lastTimestamp is timestamp)
            );

      allow update:
        if validThreadData(request.resource.data) &&
           (
              (dmOwnsMessagingCampaign() &&
                (
                  (
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'lastMessage', 'lastTimestamp'
                    ]) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasAll([
                      'lastMessage', 'lastTimestamp'
                    ]) &&
                    request.resource.data.lastMessage is string &&
                    request.resource.data.lastTimestamp is timestamp &&
                    request.resource.data.get('unreadForDM', 0) ==
                      resource.data.get('unreadForDM', 0)
                  ) ||
                  (
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'unreadForDM'
                    ]) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasAll([
                      'unreadForDM'
                    ]) &&
                    resource.data.get('unreadForDM', 0) > 0 &&
                    request.resource.data.unreadForDM == 0
                  ) ||
                  (
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'lastMessage', 'lastTimestamp', 'unreadForDM'
                    ]) &&
                    request.resource.data.get('lastMessage', null) == null &&
                    request.resource.data.get('lastTimestamp', null) == null &&
                    request.resource.data.get('unreadForDM', 0) == 0 &&
                    (
                      resource.data.get('lastMessage', null) != null ||
                      resource.data.get('lastTimestamp', null) != null ||
                      resource.data.get('unreadForDM', 0) > 0
                    )
                  )
                )) ||
              (
                playerOwnsCharacter() &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'lastMessage',
                 'lastTimestamp',
                 'unreadForDM'
                ]) &&
                request.resource.data.diff(resource.data).affectedKeys().hasAll([
                  'lastMessage',
                  'lastTimestamp',
                  'unreadForDM'
                ]) &&
                request.resource.data.lastMessage is string &&
                request.resource.data.lastTimestamp is timestamp &&
                request.resource.data.get('unreadForDM', 0) ==
                 resource.data.get('unreadForDM', 0) + 1
             )
           );

      // Only DM can delete a thread summary (clear chat)
      allow delete: if dmOwnsMessagingCampaign();

      match /messages/{messageId} {
        // DM reads all; player reads only their own character's thread messages
        allow get: if dmOwnsMessagingCampaign() || playerOwnsCharacter();
        allow list:
          if (dmOwnsMessagingCampaign() || playerOwnsCharacter()) && boundedQuery(100);

        // DM or the character owner can send messages; fromUid must match sender
        allow create:
          if (dmOwnsMessagingCampaign() || playerOwnsCharacter()) &&
             request.resource.data.keys().hasOnly([
               'fromUid',
               'text',
               'timestamp',
               'read'
             ]) &&
             request.resource.data.fromUid is string &&
             request.resource.data.fromUid.size() > 0 &&
             request.resource.data.fromUid.size() <= 1500 &&
             playerOwnsOrLinked(request.resource.data.fromUid) &&
             request.resource.data.text is string &&
             request.resource.data.text.size() > 0 &&
             request.resource.data.text.size() <= 2000 &&
             (request.resource.data.timestamp == null || request.resource.data.timestamp is timestamp) &&
             request.resource.data.read == false;

        // DM can delete messages (clear chat); nobody can edit
        allow delete: if dmOwnsMessagingCampaign();
        allow update: if false;
      }
    }

    // ============================
    // XP PROPOSALS
    // ============================
    match /campaigns/{campaignId}/characters/{characterId}/xpProposals/{proposalId} {

      function dmOwnsCampaign() {
        return dmOwnsOrLinked(
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmId
        );
      }

      function canReadProposal() {
        return dmOwnsCampaign() ||
               playerOwnsOrLinked(
                 get(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId))
                   .data.userId
               );
      }

      allow get: if canReadProposal();
      allow list: if canReadProposal() && boundedQuery(440);

      // The application has no live XP-proposal workflow. Closing direct writes
      // prevents standalone proposal spam while retaining bounded legacy reads
      // and DM cleanup during character deletion.
      allow create, update: if false;
      allow delete:
        if dmOwnsCampaign() &&
           !existsAfter(
             /databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId)
           );
    }

    // Required for collectionGroup("characters") queries — restricted to own characters only.
    match /{path=**}/characters/{characterId} {
      allow get: if playerOwnsOrLinked(resource.data.userId);
      allow list: if playerOwnsOrLinked(resource.data.userId) && boundedQuery(1000);
    }

    // All unlisted paths are denied by default.
  }
}
