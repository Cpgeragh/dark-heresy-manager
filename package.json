{
  "name": "dark-heresy-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --config vitest.config.fast.ts",
    "test:ui": "vitest --ui --config vitest.config.fast.ts",
    "test:fast": "vitest run --config vitest.config.fast.ts",
    "test:changed": "vitest run --config vitest.config.fast.ts --changed",
    "test:heavy": "vitest run tests/integration/TalentsTab.test.tsx tests/integration/TalentsTab.overflowFlows.test.tsx",
    "test:run": "npm run test:fast && npm run test:heavy",
    "test:run:serial": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project dh-test \"vitest run --config vitest.config.rules.ts\"",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only functions,firestore,auth --project dh-test \"vitest run --config vitest.config.functions.ts\"",
    "test:functions:unit": "npm --prefix functions test",
    "test:all": "npm run test:run && npm run test:rules && npm run test:functions:unit && npm run test:functions",
    "check:secrets": "node scripts/checkLocalSafety.mjs --secrets",
    "check:lockfile": "node scripts/checkLocalSafety.mjs --lockfile",
    "check:safety": "node scripts/checkLocalSafety.mjs",
    "check:deployment:local": "npm run check:safety && npm run build && npm run test:all",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.2.6",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.9",
    "firebase": "^12.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
